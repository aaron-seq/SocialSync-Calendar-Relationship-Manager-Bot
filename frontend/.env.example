# Supabase — required. The app shows a setup screen without these.
# Settings → API in your Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Groq — optional. Without it, drafts fall back to built-in templates.
# Get one at https://console.groq.com/keys
#
# WARNING: VITE_ vars are inlined into the client bundle and are readable by
# anyone who opens devtools on a deployed site. Safe for local use only.
# Before deploying publicly, proxy this through a Supabase Edge Function.
VITE_GROQ_API_KEY=
